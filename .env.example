SEC_USER_AGENT=Your Name your.email@example.com
PORT=3002
# The address the server listens on (default 127.0.0.1: reachable only from
# this machine, or through a proxy on it). Set HOST=0.0.0.0 only on purpose.
# HOST=127.0.0.1

# Optional cache tuning (defaults shown) — see cache.js
# CACHE_DB_PATH=./cache.db

# Vantage v2 warehouse (SEC bulk N-PORT history, see docs/ARCHITECTURE.md).
# Built with `npm run ingest:bulk -- --all` (~14 min, ~365 MB for 2019Q4 on).
# WAREHOUSE_DB_PATH=./warehouse.db
# SEARCH_CACHE_TTL_MS=3600000

# Outbound SEC pacing and inbound API cap (defaults shown). SEC allows ~10
# requests/second; requests are spaced this many ms apart process-wide (never
# under 100 in production; 0 only for the offline tests; a web server and a
# refresh on one machine each pace themselves), and throttled (429/503)
# responses are retried patiently. The API cap is per
# visitor per minute and only needs to stop a scripted flood — a large
# Watchlist run with a warm cache is ~1,000 requests.
# SEC_MIN_INTERVAL_MS=110
# API_RATE_LIMIT_PER_MIN=1500

# Requests with ?refresh=1 skip the cache and force fresh SEC fetches, so they
# get a separate, much smaller per-visitor budget.
# REFRESH_RATE_LIMIT_PER_MIN=30

# EDGAR full-text search returns 100 hits per request; searches page through
# up to this many matching documents in total. Names with more matches than
# this are read newest-first in 92-day windows instead of by relevance, which
# adds about one request per window (typically 10–40 requests per search).
# EFTS_MAX_HITS=1000

# Set to "production" when deploying somewhere other than your own machine.
# It refuses to start without a real SEC_USER_AGENT above (rather than silently
# sharing a generic one across every visitor), and on a loopback HOST trusts one
# proxy hop of X-Forwarded-For for per-visitor rate limits.
# NODE_ENV=production
# How many reverse proxies sit in front (X-Forwarded-For hops to trust); 0 never
# trusts the header. Set it only when clients cannot reach PORT directly: an
# exposed origin with a trusted header lets anyone pick their own address.
# TRUST_PROXY=1

# ── Public deployment (P9, docs/plans/P9-deployment.md) ──
# The public site: v1's live per-filing routes (SEC calls per visitor) and its
# page answer 410; everything comes from the warehouse.
# VANTAGE_PUBLIC=1
# The code version (the deploy sets it to the commit): the ETag on warehouse
# answers, and what open tabs compare to offer a reload after a deploy.
# APP_BUILD=
# Seconds a shared cache (Cloudflare) may serve a warehouse answer without
# asking (browsers always revalidate). 0 = no shared caching.
# VANTAGE_CDN_MAX_AGE=300
# Wait this long before warming a newly published generation, so two instances
# behind one balancer never warm at once (set it on the second instance only).
# VANTAGE_WARM_DELAY_MS=60000
# /readyz?fresh=1 fails when the last data refresh is older than this.
# VANTAGE_READY_MAX_AGE_HOURS=48
# Byte budget of the server's per-date and per-firm answer cache.
# VANTAGE_MEMO_MAX_MB=256
# Copies the backup directory off this host after the nightly backup
# (BACKUP_DIR and BACKUP_FILE are set), e.g. to Cloudflare R2 with rclone.
# VANTAGE_OFFSITE_CMD=rclone sync "$BACKUP_DIR" r2:vantage-backups
# The site's public address: canonical and Open Graph URLs, and the nightly
# smoke check when VANTAGE_SMOKE_URL is not set.
# VANTAGE_PUBLIC_URL=https://vantage.example.com
# Where the nightly smoke check (scripts/smoke.js) reads the site; on the server
# its own proxy, so no bot check at the CDN gets in the way.
# VANTAGE_SMOKE_URL=http://127.0.0.1:8080
# The uptime monitor's public status page, linked from /status (https only).
# VANTAGE_STATUS_URL=https://stats.uptimerobot.com/...
# Cloudflare Web Analytics (cookieless): the site token (32 hex characters).
# Adds its beacon to every page and allows it in the CSP; off when unset.
# VANTAGE_ANALYTICS_TOKEN=
