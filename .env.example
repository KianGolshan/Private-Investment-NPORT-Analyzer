SEC_USER_AGENT=Your Name your.email@example.com
PORT=3002

# Optional cache tuning (defaults shown) — see cache.js
# CACHE_DB_PATH=./cache.db
# SEARCH_CACHE_TTL_MS=3600000

# Set to "production" when deploying somewhere other than your own machine.
# This does two things (see server.js): refuses to start without a real
# SEC_USER_AGENT above (rather than silently sharing a generic one across
# every visitor), and trusts the X-Forwarded-For header for rate-limiting
# (only safe once you're actually behind a reverse proxy/load balancer).
# NODE_ENV=production
