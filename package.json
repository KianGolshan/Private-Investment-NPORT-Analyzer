{
  "name": "nport-analyzer",
  "version": "1.0.0",
  "description": "Vantage - private investment exposure and valuation marks extracted from SEC filings",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:live": "LIVE_SEC=1 node --test test/live-e2e.test.js test/live-popular.test.js test/live-warehouse.test.js",
    "ingest:bulk": "node scripts/ingest-bulk.js",
    "ingest:delta": "node scripts/ingest-delta.js",
    "refresh": "node scripts/refresh.js",
    "ingest:ncen": "node scripts/ingest-ncen.js",
    "seed:entities": "node scripts/seed-entities.js",
    "review:aliases": "node scripts/review-aliases.js"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "xml2js": "^0.6.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "nock": "^14.0.17",
    "nodemon": "^3.0.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
