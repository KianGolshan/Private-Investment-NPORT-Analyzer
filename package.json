{
  "name": "vantage",
  "version": "2.3.0",
  "description": "Private-company holdings and marks, straight from SEC fund filings (N-PORT, since 2019Q4)",
  "homepage": "https://vantage-kian.duckdns.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KianGolshan/Private-Investment-NPORT-Analyzer.git"
  },
  "author": "Kian Golshan (https://kiangolshan.com)",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=2 test/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:live": "LIVE_SEC=1 node --test test/live-warehouse.test.js",
    "ingest:bulk": "node scripts/ingest-bulk.js",
    "ingest:delta": "node scripts/ingest-delta.js",
    "refresh": "node scripts/refresh.js",
    "warehouse": "node scripts/warehouse.js",
    "doctor": "node scripts/doctor.js",
    "backup": "node scripts/backup.js",
    "nightly": "node scripts/nightly.js",
    "reconcile": "node scripts/reconcile.js",
    "watch": "node scripts/watch.js",
    "monthly": "node scripts/monthly.js",
    "ingest:ncen": "node scripts/ingest-ncen.js",
    "seed:entities": "node scripts/seed-entities.js",
    "review:aliases": "node scripts/review-aliases.js",
    "entities:report": "node scripts/entities-report.js",
    "bench": "node scripts/bench.js",
    "build:web": "npm --prefix web run build",
    "test:web": "npm --prefix web run typecheck && npm --prefix web test",
    "test:e2e": "npm --prefix web run e2e",
    "lint:web": "npm --prefix web run lint",
    "dev:web": "npm --prefix web run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "axios": "^1.6.7",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "xml2js": "^0.6.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "nock": "^14.0.17",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
