# Caddy for the direct edge (P9, a free DuckDNS name; docs/DEPLOY.md part 1A):
# visitors reach this server on 443, and Caddy gets and renews the HTTPS
# certificate from Let's Encrypt on its own (port 80 must be open for that).
# setup.sh installs it as /etc/caddy/Caddyfile with __DOMAIN__ filled in.
# With your own domain through Cloudflare, deploy/Caddyfile is used instead.

(vantage_app) {
	reverse_proxy 127.0.0.1:3002 127.0.0.1:3003 {
		lb_policy least_conn
		# an instance restarting (a deploy) or warming: try the other one
		lb_try_duration 15s
		lb_try_interval 250ms
		health_uri /readyz
		health_interval 5s
		health_timeout 3s
		# no proxy in front: the visitor's address is the connection's; the app
		# trusts this one hop (TRUST_PROXY=1), so rate limits are per visitor
		header_up X-Forwarded-For {client_ip}
	}
}

__DOMAIN__ {
	# no CDN in front: compress pages and scripts here (JSON the app already
	# gzipped is passed through)
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	import vantage_app
	log {
		output file /var/log/caddy/vantage.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
}

# Loopback, for deploy.sh's and the nightly run's smoke checks (VANTAGE_SMOKE_URL).
http://:8080 {
	bind 127.0.0.1
	import vantage_app
}
