# Staging (P9): the staging branch on port 3010, behind Cloudflare Access at
# staging.<domain>. Reads production's warehouse read-only; runs no jobs.
[Unit]
Description=Vantage web (staging)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# vantage-web (review M3): reads the release and the published data, writes nothing,
# and is not the user that owns the code, the data or the deploy settings.
User=vantage-web
Group=vantage-web
WorkingDirectory=/opt/vantage/staging/current
EnvironmentFile=/etc/vantage/vantage.env
EnvironmentFile=-/var/lib/vantage/build-staging.env
Environment=PORT=3010
Environment=VANTAGE_CDN_MAX_AGE=0
ExecStart=/usr/bin/node /opt/vantage/staging/current/server.js
Restart=always
RestartSec=2
MemoryMax=1G
# Sandbox (review M3): the web user writes nothing anywhere and owns nothing it
# runs from or reads; no capabilities, devices, kernel or namespace access, and
# only the system calls and address families a network service needs.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
# the web needs none of the jobs' secrets (they stay in the job units' environment)
UnsetEnvironment=DUCKDNS_TOKEN VANTAGE_ALERT_URL VANTAGE_R2_ACCESS_KEY_ID VANTAGE_R2_SECRET_ACCESS_KEY VANTAGE_OFFSITE_CMD

[Install]
WantedBy=multi-user.target
